<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Standard bundle metadata — Xcode substitutes $(VARIABLE) values at build time. -->
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<!-- BNDL means this is a generic bundle (not an .app). Screensavers are bundles. -->
	<key>CFBundlePackageType</key>
	<string>BNDL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<!-- NSPrincipalClass tells macOS which class to instantiate as the screensaver view.
	     This must match the @objc(...) name in FlipClockScreensaverView.swift. -->
	<key>NSPrincipalClass</key>
	<string>FlipClockScreensaverView</string>
</dict>
</plist>
